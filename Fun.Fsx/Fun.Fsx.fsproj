<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<PublishSelfContained>true</PublishSelfContained>
		<PublishTrimmed>true</PublishTrimmed>
		<RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;win-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
		<PublishAot>true</PublishAot>
		<StripSymbols>true</StripSymbols>
		<AssemblyName>fsx</AssemblyName>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>fsx</ToolCommandName>
		<RollForward>Major</RollForward>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Types.fs" />
		<Compile Include="Lock.fs" />
		<Compile Include="Project.fs" />
		<Compile Include="Execution.fs" />
		<Compile Include="Program.fs" />
	</ItemGroup>

</Project>
